/dts-v1/;

#include <espressif/esp32s3/esp32s3.dtsi>
#include "communicator_badge-pinctrl.dtsi"
#include <espressif/partitions_0x0_amp_16M.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/keymap.h>
#include <zephyr/dt-bindings/lora/sx126x.h>
#include <zephyr/dt-bindings/lvgl/lvgl.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
	model = "Hackaday Communicator Badge PROCPU";
	compatible = "espressif,esp32s3";

	aliases {
		i2c-0 = &i2c0;
		led0 = &led0;
		lora0 = &lora;
		uart-0 = &uart0;
		watchdog0 = &wdt0;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &esp32_bt_hci;
		zephyr,display = &nv3007;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
			label = "Side LED";
		};
	};

	lvgl_keypad: lvgl-keypad {
		compatible = "zephyr,lvgl-keypad-input";
		input = <&keymap>;
		input-codes = <INPUT_KEY_UP INPUT_KEY_DOWN INPUT_KEY_LEFT INPUT_KEY_RIGHT
			       INPUT_KEY_ENTER INPUT_KEY_ESC INPUT_KEY_BACKSPACE INPUT_KEY_TAB>;
		lvgl-codes = <LV_KEY_UP LV_KEY_DOWN LV_KEY_LEFT LV_KEY_RIGHT
			      LV_KEY_ENTER LV_KEY_ESC LV_KEY_BACKSPACE LV_KEY_NEXT>;
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;
		dc-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;		/* GPIO39 */
		reset-gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;	/* GPIO40 */
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		/* 2.79 inch 142x428 panel, used in landscape */
		nv3007: lcd@0 {
			compatible = "newvision,nv3007";
			reg = <0>;
			mipi-max-frequency = <DT_FREQ_M(80)>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			width = <428>;
			height = <142>;
			madctl = <0xa0>;
			y-offset = <12>;
		};
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
	ranges = <0x0 0x0 DT_SIZE_M(16)>;
};

&psram0 {
	size = <DT_SIZE_M(8)>;
};

&dma {
	status = "okay";
};

&gpio0 {
	status = "okay";

	/* Backlight transistor; the pin can be handed to ledc0 for dimming */
	lcd_backlight {
		gpio-hog;
		gpios = <2 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "lcd-backlight";
	};
};

&gpio1 {
	status = "okay";
};

/* SAO header */
&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";

	keyboard: keyboard@34 {
		compatible = "ti,tca8418";
		reg = <0x34>;
		int-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio1 16 GPIO_ACTIVE_LOW>;	/* GPIO48 */
		row-size = <8>;
		col-size = <10>;

		keymap: keymap {
			compatible = "input-keymap";
			keymap = <
				MATRIX_KEY(0, 1, INPUT_KEY_F1)
				MATRIX_KEY(0, 2, INPUT_KEY_KPPLUS)
				MATRIX_KEY(0, 3, INPUT_KEY_9)
				MATRIX_KEY(0, 4, INPUT_KEY_8)
				MATRIX_KEY(0, 5, INPUT_KEY_7)
				MATRIX_KEY(0, 6, INPUT_KEY_F2)
				MATRIX_KEY(0, 7, INPUT_KEY_F3)
				MATRIX_KEY(0, 8, INPUT_KEY_F4)
				MATRIX_KEY(0, 9, INPUT_KEY_F5)
				MATRIX_KEY(1, 0, INPUT_KEY_ESC)
				MATRIX_KEY(1, 1, INPUT_KEY_Q)
				MATRIX_KEY(1, 2, INPUT_KEY_W)
				MATRIX_KEY(1, 3, INPUT_KEY_E)
				MATRIX_KEY(1, 4, INPUT_KEY_R)
				MATRIX_KEY(1, 5, INPUT_KEY_T)
				MATRIX_KEY(1, 6, INPUT_KEY_Y)
				MATRIX_KEY(1, 7, INPUT_KEY_U)
				MATRIX_KEY(1, 8, INPUT_KEY_I)
				MATRIX_KEY(1, 9, INPUT_KEY_O)
				MATRIX_KEY(2, 0, INPUT_KEY_TAB)
				MATRIX_KEY(2, 1, INPUT_KEY_A)
				MATRIX_KEY(2, 2, INPUT_KEY_S)
				MATRIX_KEY(2, 3, INPUT_KEY_D)
				MATRIX_KEY(2, 4, INPUT_KEY_F)
				MATRIX_KEY(2, 5, INPUT_KEY_G)
				MATRIX_KEY(2, 6, INPUT_KEY_H)
				MATRIX_KEY(2, 7, INPUT_KEY_J)
				MATRIX_KEY(2, 8, INPUT_KEY_K)
				MATRIX_KEY(2, 9, INPUT_KEY_L)
				MATRIX_KEY(3, 0, INPUT_KEY_LEFTSHIFT)
				MATRIX_KEY(3, 1, INPUT_KEY_Z)
				MATRIX_KEY(3, 2, INPUT_KEY_X)
				MATRIX_KEY(3, 3, INPUT_KEY_C)
				MATRIX_KEY(3, 4, INPUT_KEY_V)
				MATRIX_KEY(3, 5, INPUT_KEY_B)
				MATRIX_KEY(3, 6, INPUT_KEY_N)
				MATRIX_KEY(3, 7, INPUT_KEY_M)
				MATRIX_KEY(3, 8, INPUT_KEY_COMMA)
				MATRIX_KEY(3, 9, INPUT_KEY_DOT)
				MATRIX_KEY(4, 0, INPUT_KEY_LEFTCTRL)
				/* Jolly Wrencher (Hackaday logo) */
				MATRIX_KEY(4, 1, INPUT_KEY_LEFTMETA)
				MATRIX_KEY(4, 2, INPUT_KEY_LEFTALT)
				MATRIX_KEY(4, 3, INPUT_KEY_BACKSLASH)
				MATRIX_KEY(4, 4, INPUT_KEY_SPACE)
				MATRIX_KEY(4, 6, INPUT_KEY_RIGHT)
				MATRIX_KEY(4, 7, INPUT_KEY_DOWN)
				MATRIX_KEY(4, 8, INPUT_KEY_LEFT)
				MATRIX_KEY(4, 9, INPUT_KEY_RIGHTALT)
				MATRIX_KEY(5, 2, INPUT_KEY_MINUS)
				MATRIX_KEY(5, 3, INPUT_KEY_6)
				MATRIX_KEY(5, 4, INPUT_KEY_5)
				MATRIX_KEY(5, 5, INPUT_KEY_4)
				MATRIX_KEY(5, 6, INPUT_KEY_RIGHTBRACE)
				MATRIX_KEY(5, 7, INPUT_KEY_LEFTBRACE)
				MATRIX_KEY(5, 8, INPUT_KEY_P)
				MATRIX_KEY(6, 2, INPUT_KEY_KPASTERISK)
				MATRIX_KEY(6, 3, INPUT_KEY_3)
				MATRIX_KEY(6, 4, INPUT_KEY_2)
				MATRIX_KEY(6, 5, INPUT_KEY_1)
				MATRIX_KEY(6, 6, INPUT_KEY_ENTER)
				MATRIX_KEY(6, 7, INPUT_KEY_APOSTROPHE)
				MATRIX_KEY(6, 8, INPUT_KEY_SEMICOLON)
				MATRIX_KEY(7, 2, INPUT_KEY_SLASH)
				MATRIX_KEY(7, 3, INPUT_KEY_EQUAL)
				/* "." on the number block, "," with shift */
				MATRIX_KEY(7, 4, INPUT_KEY_KPDOT)
				MATRIX_KEY(7, 5, INPUT_KEY_0)
				MATRIX_KEY(7, 6, INPUT_KEY_RIGHTSHIFT)
				MATRIX_KEY(7, 7, INPUT_KEY_UP)
				MATRIX_KEY(7, 8, INPUT_KEY_BACKSPACE)
			>;
			row-size = <8>;
			col-size = <10>;
		};
	};
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(80)>;
	dma-enabled;
	dmas = <&dma 0>, <&dma 1>;
	dma-names = "rx", "tx";
};

/* Seeed Wio-SX1262 module, behind a pi attenuator unless JP1 is bridged */
&spi3 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim3_default>;
	pinctrl-names = "default";

	lora: lora@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(4)>;
		reset-gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		/* RF switch: GPIO10 selects the receive path, DIO2 the transmit path */
		rx-enable-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
		dio2-tx-enable;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V7>;
		tcxo-power-startup-delay-ms = <5>;
	};
};

/* Serial expansion header J7, not fitted */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&usb_serial {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};
